<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Vários Lorem Ipsum — Exemplo</title>
  <style>
    :root{
      --bg:#f7f8fb;
      --card:#ffffff;
      --muted:#6b7280;
      --accent:#2563eb;
      --radius:12px;
      font-family: Inter, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
    }
    body{
      margin:0;
      background:linear-gradient(180deg, var(--bg), #eef2ff);
      color:#111827;
      -webkit-font-smoothing:antialiased;
      -moz-osx-font-smoothing:grayscale;
      padding:32px;
    }
    .wrap{
      max-width:1000px;
      margin:0 auto;
      display:grid;
      grid-template-columns: 280px 1fr;
      gap:24px;
    }
    header{
      grid-column:1/-1;
      display:flex;
      align-items:center;
      gap:16px;
      margin-bottom:8px;
    }
    header h1{margin:0;font-size:1.4rem;}
    .toc{
      background:var(--card);
      padding:16px;
      border-radius:var(--radius);
      box-shadow:0 6px 20px rgba(16,24,40,0.06);
      position:sticky;
      top:24px;
      height:fit-content;
    }
    .toc h2{margin:.25rem 0 .5rem 0;font-size:1rem}
    .toc a{
      display:block;
      color:var(--accent);
      text-decoration:none;
      margin:.25rem 0;
      font-size:.95rem;
    }
    main{
      background:transparent;
    }
    section.card{
      background:var(--card);
      padding:20px;
      border-radius:var(--radius);
      margin-bottom:18px;
      box-shadow:0 6px 18px rgba(15,23,42,0.05);
    }
    section.card h3{margin-top:0}
    footer{
      grid-column:1/-1;
      text-align:center;
      color:var(--muted);
      margin-top:8px;
      font-size:.9rem;
    }

    /* visual para código/lorem curto */
    pre.lorem{
      white-space:pre-wrap;
      margin:0;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, "Roboto Mono", monospace;
      background:#0f172a0f;
      padding:12px;
      border-radius:8px;
      color:#0f172a;
      font-size:.92rem;
    }

    @media (max-width:880px){
      .wrap{grid-template-columns:1fr; padding:0 12px;}
      .toc{position:static;}
    }
  </style>
</head>
